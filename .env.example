# ---- Postgres (Neon) ----
# Pooled connection string from Neon dashboard, e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Auth (NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Google OAuth (optional) ---
# Create a project + OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email magic-link (optional) ---
# Resend is the primary transport (composed to smtp://resend:KEY@smtp.resend.com:587).
# Create an API key at https://resend.com/api-keys (free tier: 3000 emails/mo).
SMTP_PROVIDER_SECRET=
EMAIL_FROM="News Timeline <onboarding@resend.dev>"
# Generic SMTP fallback if you're NOT using Resend (overrides/none when Resend key set).
# EMAIL_SERVER=smtp://user:pass@host:587

# ---- Local dev convenience ----
# Demo user email used by seed.ts; also the identity the demo account logs in as.
DEMO_EMAIL=demo@timeline.news

# ---- Admin (editing global sources, "Run now" pipeline) ----
# Comma-separated emails that are ADMIN. Without this, NO user is an admin
# (there is no silent admin). The dev demo login is a normal user unless its
# email is listed here. E.g. ADMIN_EMAILS=demo@timeline.news
ADMIN_EMAILS=

# ---- GitHub Actions / admin "Run now" ----
# Owner/repo and a token with 'actions:write' to dispatch ingest.yml manually.
# These are set in the repo secrets, not tracked.
GITHUB_REPO=
GITHUB_TOKEN=