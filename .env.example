# ---- Postgres (Neon) ----
# Pooled connection string from Neon dashboard, e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Auth (NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Google OAuth (optional) ---
# Create a project + OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public client id (safe to expose) — tells the sign-in page whether Google is on.
NEXT_PUBLIC_AUTH_GOOGLE_ID=

# --- Email magic-link (optional) ---
# Email transport for magic links. For local/dev use a provider like resend/brevo.
# The app BUILDS without this (sign-in is disabled until set), but magic-link
# logins need it. NextAuth email provider requires an SMTP or API config.
EMAIL_SERVER=
EMAIL_FROM="News Timeline <noreply@timeline.news>"

# ---- Local dev convenience ----
# Demo user email used by seed.ts; also the identity the demo account logs in as.
DEMO_EMAIL=demo@timeline.news

# ---- GitHub Actions ----
# These are set in the repo secrets, not tracked. The workflow reads them.
# NEXT_PUBLIC_AUTH_URL=https://your-app.vercel.app